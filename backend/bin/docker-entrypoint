#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Create or migrate the database. In production deploy.sh migrates once before the
# rollout and the stack sets SKIP_DB_PREPARE=1: several containers starting together
# would otherwise race for the migration lock (ActiveRecord::ConcurrentMigrationError).
if [ "${SKIP_DB_PREPARE:-}" != "1" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
