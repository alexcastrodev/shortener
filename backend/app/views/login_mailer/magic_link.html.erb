<%# Hidden preview line shown by inbox lists next to the subject. %>
<div style="display:none;max-height:0;overflow:hidden;">
  <%= @body %> It expires in <%= @valid_minutes %> minutes.
</div>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="bg" style="background:#f7f8fa;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:480px;">
        <tr>
          <td style="padding:0 4px 20px;font:700 22px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;letter-spacing:-0.5px;" class="fg">
            <span class="fg" style="color:#111827;">kurz</span><span class="dot" style="color:#116d6e;">.</span>
          </td>
        </tr>
        <tr>
          <td class="card" style="background:#ffffff;border:1px solid #d9e0e7;border-radius:12px;padding:28px;">
            <p class="fg" style="margin:0 0 8px;font:600 18px/1.4 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
              <%= @title %>
            </p>
            <p class="muted" style="margin:0 0 20px;font:400 14px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#4b5563;">
              <%= @body %>
            </p>
            <div class="code" style="margin:0 0 20px;padding:16px;border-radius:10px;background:#eef6f6;text-align:center;font:700 30px/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:6px;color:#111827;">
              <%= @code %>
            </div>
            <p class="muted" style="margin:0;font:400 13px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#4b5563;">
              The code expires in <%= @valid_minutes %> minutes and works once.
            </p>
          </td>
        </tr>
        <tr>
          <td class="muted" style="padding:16px 4px 0;font:400 12px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#6b7280;">
            You're getting this because <%= @reason %>.
            If it wasn't you, you can ignore this email.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
