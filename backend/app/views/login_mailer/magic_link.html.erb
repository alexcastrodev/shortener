<%= render "shared/mailer/intro", title: @title, lead: @body, preheader: "#{@body} #{t(".preview", minutes: @valid_minutes)}" %>
<div class="code" style="margin:24px 0 0;padding:18px;border-radius:10px;background:#eef6f6;text-align:center;font:700 30px/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:6px;color:#111827;"><%= @code %></div>
<%= render "shared/mailer/note", text: t(".expires", minutes: @valid_minutes) %>
