<% content_for(:preheader, local_assigns[:preheader] || lead) %>
<h1 class="fg headline" style="margin:0;font-size:22px;line-height:1.3;font-weight:700;color:#111827;"><%= title %></h1>
<% if lead.present? %>
  <p class="muted" style="margin:8px 0 0;font-size:15px;line-height:1.6;color:#4b5563;"><%= lead %></p>
<% end %>
