<table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="bg" style="background:#f7f8fa;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:480px;">
        <tr>
          <td class="card" style="background:#ffffff;border:1px solid #d9e0e7;border-radius:12px;padding:28px;font:400 14px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
            <p class="fg" style="margin:0 0 8px;font-weight:600;font-size:18px;"><%= t(".title") %></p>
            <p class="muted" style="margin:0 0 12px;color:#4b5563;"><%= t(".intro", service: @service) %></p>
            <p style="margin:0 0 4px;color:#4b5563;"><%= t(".was", time: @was) %></p>
            <p style="margin:0 0 12px;font-weight:600;"><%= t(".now", time: @now) %></p>
            <% if @message %>
              <p class="muted" style="margin:0 0 12px;color:#4b5563;"><%= t(".message", message: @message) %></p>
            <% end %>
            <p class="muted" style="margin:0 0 12px;color:#4b5563;"><%= t(".reply") %></p>
            <p style="margin:0;"><a href="<%= @manage_url %>" style="color:#116d6e;"><%= t(".manage_link") %></a></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
