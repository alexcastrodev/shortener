<%= render "shared/mailer/intro", title: t(".title"), lead: t(".lead", name: @client_name, service: @service) %>
<%= render "shared/mailer/details", rows: booking_rows(**@booking) %>
<%= render "shared/mailer/action", url: @decide_url, label: t(".decide_link"), note: t(@accept_on_timeout ? ".deadline_accept" : ".deadline_decline", deadline: mail_moment(@deadline, @booking[:zone])), links: [[t("mailer.see_responses"), @responses_url]] %>
