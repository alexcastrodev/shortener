<% date = l(@due_on, format: :mail_date) %>
<%= render "shared/mailer/intro", title: t(".title", date: date), lead: t(".body", email: @user.email, date: date) %>
<%= render "shared/mailer/action", url: @sign_in_url, label: t(".sign_in"), note: t(".changed_mind", date: date) %>
<%= render "shared/mailer/note", text: t(".not_you") %>
