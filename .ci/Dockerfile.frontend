FROM node:26-bookworm@sha256:2aaae6d91f99fee84cfc92da9b52c22a185752d247746052bbc3f961e44478c6 AS development-dependencies-env
COPY ./frontend /app
WORKDIR /app
RUN npm ci --legacy-peer-deps

FROM node:26-bookworm@sha256:2aaae6d91f99fee84cfc92da9b52c22a185752d247746052bbc3f961e44478c6 AS production-dependencies-env
COPY ./frontend/package.json ./frontend/package-lock.json /app/
COPY ./frontend/packages /app/packages
WORKDIR /app
RUN npm ci --omit=dev --legacy-peer-deps

FROM node:26-bookworm@sha256:2aaae6d91f99fee84cfc92da9b52c22a185752d247746052bbc3f961e44478c6 AS build-env
COPY ./frontend /app/
COPY --from=development-dependencies-env /app/node_modules /app/node_modules
WORKDIR /app
# Defaults are the production values, so deploys build exactly as before; the security harness
# overrides VITE_BASE_URL so the SSR loaders never reach the real API.
ARG VITE_BASE_URL=https://api.kurz.fyi
ARG VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFBRUw_QzHwFb0hJ
# Google OAuth client id (public; the API checks ID tokens were issued for it).
ARG VITE_GOOGLE_CLIENT_ID=146729417680-n6ldv12khpr8g2scv3qqof9ibbnnpr95.apps.googleusercontent.com
ENV VITE_BASE_URL=$VITE_BASE_URL \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
# Node resolves "localhost" to ::1 first in this base image, but the
# react-router v8 prerender preview server binds IPv4, so the prerender
# fetch gets ECONNREFUSED. Force IPv4 resolution to match the binding.
# https://github.com/remix-run/react-router/issues/15255
ENV NODE_OPTIONS=--dns-result-order=ipv4first
RUN npm run build

FROM node:26-bookworm@sha256:2aaae6d91f99fee84cfc92da9b52c22a185752d247746052bbc3f961e44478c6
COPY ./frontend/package.json ./frontend/package-lock.json /app/
COPY --from=production-dependencies-env /app/node_modules /app/node_modules
COPY --from=build-env /app/build /app/build
WORKDIR /app

CMD ["npm", "run", "start"]